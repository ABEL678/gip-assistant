# ============ App ============
APP_NAME=GIP-Assistant
APP_ENV=dev
APP_DEBUG=true

# ============ Database ============
DB_HOST=127.0.0.1
DB_PORT=5555
DB_NAME=gip_assistant
DB_USER=gip
DB_PASSWORD=gip_dev_password

# ============ JWT ============
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440

# ============ Telegram ============
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_DIGEST_CRON=0 9 * * *
TELEGRAM_PROXY=http://127.0.0.1:10809

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ LLM ============
# Fernet-ключ для llm_settings.api_key_encrypted.
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=